# ============================================================
# LG docker-compose 环境变量模板
# ----------------------------------------------------------
# 使用：cp .env.docker.example .env.docker
#       自行修改 .env.docker 里的密码后再启动
# .env.docker 已在 .gitignore，不会提交到仓库
#
# 字段名跟 D:\docker\.env 完全对齐 —— 维护一处即可，可直接把
# D:\docker\.env 内容复制到本项目 .env.docker 启动，无需改名。
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_PASSWORD=postgres

# LG 项目独有：业务库与 RAG 向量库物理隔离，单 PG 实例双 DB
# - 业务库 PG_DATABASE：保持干净，不装任何扩展（默认 lg_test）
# - RAG 库 PG_RAG_DB：仅它装 pgvector + pg_trgm，业务表完全不受影响
PG_PORT=5432
PG_DATABASE=lg_test
PG_RAG_DB=lg_rag
PG_USER=postgres

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_NACOS_PASSWORD=nacos
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=Black.123
REDIS_PORT=6379

# ---------- Nacos ----------
# JWT 签名密钥，长度需 ≥ 64 字符；生产环境请替换为随机字符串
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_PORT=8848

# ============================================================
# 可选服务（默认在 docker-compose.yml 里都注释了，启用时同步取消注释）
# ============================================================

# ---------- MinIO ----------
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=Black.123
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ---------- Elasticsearch ----------
# ELASTIC_PASSWORD=Black.123
# ES_PORT=9200
